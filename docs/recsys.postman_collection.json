              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"user_id\": 999999,\n  \"strategy\": \"collaborative\",\n  \"recommendations\": [\n    {\n      \"id\": 356,\n      \"title\": \"Forrest Gump (1994)\",\n      \"genres\": [\"Comedy\", \"Drama\", \"Romance\", \"War\"]\n    }\n  ]\n}"
            }
