    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Get recommendations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/recommendations?user_id={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations"],
              "query": [
                { "key": "user_id", "value": "{{userId}}", "description": "required, integer" }
              ]
            },
            "description": "Hybrid dispatch: if the user is in the trained model the response comes back with `strategy: \"rating_based\"`; otherwise it falls back to the genre-aware popularity cold start (`strategy: \"collaborative\"`)."
          },
          "response": [
            {
              "name": "200 OK (trained model)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/recommendations?user_id=1",
                  "host": ["{{baseUrl}}"],
                  "path": ["recommendations"],
                  "query": [{ "key": "user_id", "value": "1" }]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"user_id\": 1,\n  \"strategy\": \"rating_based\",\n  \"recommendations\": [\n    {\n      \"id\": 318,\n      \"title\": \"Shawshank Redemption, The (1994)\",\n      \"genres\": [\"Crime\", \"Drama\"]\n    },\n    {\n      \"id\": 296,\n      \"title\": \"Pulp Fiction (1994)\",\n      \"genres\": [\"Comedy\", \"Crime\", \"Drama\", \"Thriller\"]\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Get recommendations - limit",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/recommendations?user_id={{userId}}&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations"],
              "query": [
                { "key": "user_id", "value": "{{userId}}" },
                { "key": "limit", "value": "5", "description": "default 20, clamped to 1..100" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get recommendations - cold start user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/recommendations?user_id={{newUserId}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations"],
              "query": [
                { "key": "user_id", "value": "{{newUserId}}", "description": "a user the trained model has never seen" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "A user the model does not know falls through to the `collaborative` recommender."
          },
          "response": [
